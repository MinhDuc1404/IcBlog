@page
@model IcBlogAdmin.Pages.UserManage.UserBlogModel
@{
    ViewData["Title"] = "UserBlog"
}
<h1>User Details</h1>


<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2>Information</h2>
            <a asp-action="Edit" class="btn btn-warning btn-sm" asp-route-id="@Model.UserAccount.Id">Edit</a>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3 font-weight-bold">Full Name:</div>
                <div class="col-md-9">@ApplicationUser.FirstName @ApplicationUser.LastName</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 font-weight-bold">Email:</div>
                <div class="col-md-9">@ApplicationUser.Email</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 font-weight-bold">Phone Number:</div>
                <div class="col-md-9">@ApplicationUser.PhoneNumber</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 font-weight-bold">Address:</div>
                <div class="col-md-9">@ApplicationUser.Address</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 font-weight-bold">Created Date:</div>
                <div class="col-md-9">@ApplicationUser.CreatedDate.ToString("f")</div>
            </div>
        </div>
    </div>
</div>

<h2>Posts</h2>