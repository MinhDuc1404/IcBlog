@page
@model IcBlogAdmin.Pages.UserManage.UserManageModel
@{
}

<h1>Welcome admin</h1>

<h2>User List</h2>
<form method="get">
    <input type="text" asp-for="SearchString" class="form-control" placeholder="Search users..."></input>
    <input type="submit" value="Filter" class="btn btn-primary mt-2"></input>
</form>

<table class="table table-striped table-bordered table-hover">
    <thead class="thead-dark">
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Phone Number</th>
            <th>Address</th>
            <th>Created At</th>
            <th>Role</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ApplicationUsers)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Address</td>
                <td>@item.CreatedDate</td>
                <td>@(Model.userRoles.ContainsKey(item.Id) ? string.Join(", ", Model.userRoles[item.Id]) : "None")</td>
                <td>
                    <div class="d-flex align-items-center">
                        <!-- Edit Button -->
                        <a class="btn btn-sm btn-info d-inline-flex align-items-center me-2" asp-page="./Edit" asp-route-id="@item.Id">
                            <i class="fas fa-edit"></i>
                        </a>
                        <!-- Delete Form -->
                        <form method="post" asp-page-handler="Delete" style="display:inline-block;">
                            <input type="hidden" name="Id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger d-inline-flex align-items-center">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<p><a class="btn btn-primary" href="/">Back To HomePage</a></p>
