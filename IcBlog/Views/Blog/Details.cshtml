@using IcBlog.Helper
@using Microsoft.AspNetCore.Identity
@using IcBlog.Infrastructure.Models
@using System.Web
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@model BlogDetailsViewModel
@{
    ViewData["Title"] = "IC Blog Details";

    var user = await UserManager.GetUserAsync(User);
}

<section class="page-title bg-1">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="block text-center">
                    <span class="text-white">IC blog</span>
                    <h1 class="text-capitalize mb-4 text-lg">Blog Details</h1>
                    <ul class="list-inline">
                        <li class="list-inline-item"><a href="/" class="text-white">Home</a></li>
                        <li class="list-inline-item"><span class="text-white">/</span></li>
                        <li class="list-inline-item"><a href="#" class="text-white-50">Blog Details</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="section blog-wrap bg-gray">
<div class="container">
    <div class="row">
        <div class="col-lg-9">
            <div class="row">
                <div class="col-lg-12 mb-5">
                    <div class="single-blog-item">
                        <div class="blog-item-content bg-white p-5">
                        <img src="~/UserFiles/@($"{AppUtilities.LocDau(Model.Blog.Author.FirstName)}{AppUtilities.LocDau(Model.Blog.Author.LastName)}")/@Model.Blog.BlogID/BlogImage.jpg" alt="" class="img-fluid rounded" style="height:50%; width:100%">
                                <h3 class="mt-3 mb-3"><a asp-controller="Blog" asp-action="Details" asp-route-id="@Model.Blog.BlogID">@Model.Blog.Title</a></h3>
                                <div class="blog-item-meta py-1 px-2">
                                    <span class="text-muted text-capitalize mr-3"><i class="ti-pencil-alt mr-2"></i>@($"{Model.Blog.Author.FirstName} {Model.Blog.Author.LastName}")</span>

                                    <span class="text-black text-capitalize mr-3"><i class="ti-time mr-1"></i>@Model.Blog.DateTime?.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="col-lg-12 col-md-10 mx-auto testing" style="word-wrap: break-word;white-space: -moz-pre-wrap;white-space: pre-wrap;">
                                    @Html.Raw(HttpUtility.HtmlDecode(Model.Blog.Content))
                                </div>

                        <div class="tag-option mt-5 clearfix">
                            <ul class="float-left list-inline">
                                <li>Tags:</li>
                                <li class="list-inline-item"><a asp-controller="Blog" asp-action="Index" asp-route-category="@Model.Blog.CategoryID" rel="tag">@Model.Blog.Category.Name</a></li>
                            </ul>

                            <ul class="float-right list-inline">
                                <li class="list-inline-item"> Share: </li>
                                <li class="list-inline-item"><a href="#" target="_blank"><i class="fab fa-facebook-f" aria-hidden="true"></i></a></li>
                                <li class="list-inline-item"><a href="#" target="_blank"><i class="fab fa-twitter" aria-hidden="true"></i></a></li>
                                <li class="list-inline-item"><a href="#" target="_blank"><i class="fab fa-pinterest-p" aria-hidden="true"></i></a></li>
                                <li class="list-inline-item"><a href="#" target="_blank"><i class="fab fa-google-plus" aria-hidden="true"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
                    <div class="col-lg-12 mb-5">
                        <div class="comment-area card border-0 p-5">
                            <h4 class="mb-4">@((Model.Blog.Comments?.Count() ?? 0)) Comments</h4>
                            <ul class="comment-tree list-unstyled">
                                @foreach (var item in Model.Blog.Comments.Where(comment => comment.CommentParent is null))
                                {
                                    <li class="mb-5">
                                        <div class="comment-area-box">
                                            <img style="width:55px;height:55px" src="~/UserFiles/@item.AuthorID/ProfilePicture.jpg" class="img-author float-left mr-3">

                                            <h5 class="mb-1">@($"{item.Author.FirstName} {item.Author.LastName}")</h5>
                                       

                                            <div class="comment-content mt-3">
                                                <p style="margin-left: 70px;position:relative;bottom:15px">@Html.Raw(item.Content)</p>
                                            </div>
                                            <div class="comment-meta mt-4 mt-lg-0 mt-md-0 float-lg-left float-md-left">
                                                @if (user == null)
                                                {
                                                    <a class="reply-btn btn" asp-area="Identity" asp-page="/Account/Login" asp-route-ReturnUrl="~/blog-details.html/@Model.Blog.BlogID">Login to reply</a>
                                                }
                                                else
                                                {
                                                    <a style="color:#4267b2;position: relative;bottom: 20px;margin-left: 63px;font-size:15px;font-weight:600" href="javascript:void(0);" onclick="toggleReplyForm(@item.Id)"><i class="icofont-reply mr-2 text-muted"></i>Phản hồi</a>
                                                }

                                            </div>
                                            <!-- Reply Form -->
                                            @if (user != null)
                                            {
                                                <div id="reply-form-@item.Id" class="reply-form" style="display: none;">
                                                    <form asp-controller="Blog" asp-action="Comment" method="post" class="mt-3">
                                                        <input asp-for="Blog.BlogID" readonly hidden />
                                                        <input asp-for="Comment.CommentParentID" value="@item.Id" readonly hidden />
                                                        <div class="form-group">
                                                            <label for="comment">Write a reply</label>
                                                            <textarea asp-for="Comment.Content" class="form-control" rows="3"></textarea>
                                                           
                                                        </div>
                                                        <button type="submit" class="btn btn-primary">Submit Reply</button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    </li>
                                    <!-- Hiển thị danh sách các bình luận trả lời -->
                                    @if (item.Replies != null && item.Replies.Any())
                                    {
                                        @foreach (var reply in item.Replies)
                                        {
                                            <li class="mb-5" style="margin-left: 80px">
                                                <div class="comment-area-box">
                                                    <img alt="" src="images/blog/test1.jpg" class="img-author float-left mr-3 mt-2">

                                                    <h5 class="mb-1">@($"{reply.Author.FirstName} {reply.Author.LastName}")</h5>

                                                    <div class="comment-content mt-3">
                                                        <p style="margin-left: 50px;">@Html.Raw(reply.Content)</p>
                                                    </div>
                                            </li>

                                        }
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                          <div class="col-lg-12">
                                   @if (user != null)
                                    {
                                     <form asp-controller="Blog" asp-action="Comment" class="contact-form bg-white rounded p-5" id="comment-form" method="post">
                                             <h4 class="mb-4">Write a comment</h4>
                                            <input asp-for="Blog.BlogID" readonly hidden />
                                            <div class="form-group">
                                                <textarea asp-for="Comment.Content" class="form-control" rows="5"></textarea>
                                                <br />
                                           <button type="submit" class="btn btn-main btn-round-full">Post</button>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        <a class="reply-btn btn" asp-area="Identity" asp-page="/Account/Login" asp-route-ReturnUrl="~/blog-details.html/@Model.Blog.BlogID">Login to Comment</a>
                                    }
                                </div>
                            </div>
                        </div>
                 @await Component.InvokeAsync("SideBar")
                    </div>
                  </div>
     </section>          
  @section Scripts
            {
                <script>
                    function toggleReplyForm(commentID) {
                        var form = document.getElementById('reply-form-' + commentID);
                        if (form) {
                            if (form.style.display === 'none' || form.style.display === '') {
                                form.style.display = 'block';
                            } else {
                                form.style.display = 'none';
                            }
                        } else {
                            console.error('Element with ID reply-form-1 not found.');
                        }
                    }
                </script>
            }

