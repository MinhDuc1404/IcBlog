@using IcBlog.Helper;
@using System.Web
@model BlogAuthorViewModel

@{
	ViewData["Title"] = "IC Author";
}
<section class="section blog-wrap bg-gray" style="padding: 40px 0">
	<div class="container-fluid">
		<div class="row">
			@if (Model.Blogs != null && Model.Blogs.Any())
			{
				foreach (var item in Model.Blogs)
				{
					<div class="col-lg-6 col-md-6 mb-5" style="padding-right:0px">
						<div class="blog-item">
							<div class="blog-item-image">
								<a asp-controller="Blog" asp-action="Details" asp-route-id="@item.BlogID">
									<img src="~/UserFiles/@($"{AppUtilities.LocDau(item.Author.FirstName)}{AppUtilities.LocDau(item.Author.LastName)}")/@item.BlogID/BlogImage.jpg" style="height:300px" alt="" class="img-fluid rounded">
								</a>
								<!-- Category label -->
								<div class="blog-item-category">
									<a asp-controller="Blog" asp-action="Index" asp-route-category="@item.CategoryID">@item.Category.Name</a>
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-6 col-md-6 mb-5" style="padding-left:0px">
						<div class="blog-item">
							<div class="blog-item-content bg-white p-5" style="height:300px">
								<h3 style="line-height: 28px; font-size:1.3rem;padding-top:30px;padding-left:10px" class="mt-3 mb-3"><a asp-controller="Blog" asp-action="Details" asp-route-id="@item.BlogID">@item.Title</a></h3>
								<div class="blog-item-meta py-1">
									<div style="word-wrap: break-word; padding-bottom:20px;padding-left:10px">
										@Html.Raw(AppUtilities.ConvertHtmlToPlainText(item.Content.Substring(0, 300)) + "...")
									</div>
									<div style="padding-left:10px">
									<span class="text-muted text-capitalize mr-3"><i class="ti-pencil-alt mr-2"></i>@($"{item.Author.FirstName} {item.Author.LastName}")</span>
		
									<span class="text-black text-capitalize mr-3"><i class="ti-time mr-1"></i>@item.DateTime?.ToString("dd/MM/yyyy")</span>
									</div>
								</div>
							</div>
						</div>
					</div>
							
				}
			}
		</div>
		<div class="row justify-content-center mt-5">
			<div class="col-lg-6 text-center">
				<a asp-controller="Blog" asp-action="Index" class="btn btn-small btn-main btn-round-full">Đọc Thêm</a>
			</div>
		</div>
	</div>
</section>