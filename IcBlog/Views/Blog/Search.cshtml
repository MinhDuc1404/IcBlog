@using IcBlog.Helper
@model SearchViewModel

@{
	ViewData["Title"] = "IC Home";
}

<section class="section blog-wrap bg-gray">
	<div class="container">
		<div class="row">
			@if (Model.Blogs != null && Model.Blogs.Any())
			{
				foreach (var item in Model.Blogs)
				{
					<div class="col-lg-4 col-md-6 mb-5">
						<div class="blog-item">
							<div class="blog-item-image">
								<a asp-controller="Blog" asp-action="Details" asp-route-id="@item.BlogID">
									<img src="~/UserFiles/@($"{AppUtilities.LocDau(item.Author.FirstName)}{AppUtilities.LocDau(item.Author.LastName)}")/@item.BlogID/BlogImage.jpg" alt="" class="img-fluid rounded">
								</a>
								<!-- Category label -->
								<div class="blog-item-category">
									<a asp-controller="Blog" asp-action="Index" asp-route-category="@item.CategoryID">@item.Category.Name</a>
								</div>
							</div>
							<div class="blog-item-content bg-white p-5">
								<h3 class="mt-3 mb-3"><a asp-controller="Blog" asp-action="Details" asp-route-id="@item.BlogID">@item.Title</a></h3>
								<div class="blog-item-meta py-1 px-2">
									<span class="text-muted text-capitalize mr-3"><i class="ti-pencil-alt mr-2"></i>@($"{item.Author.FirstName} {item.Author.LastName}")</span>

									<span class="text-black text-capitalize mr-3"><i class="ti-time mr-1"></i>@item.DateTime?.ToString("dd/MM/yyyy")</span>
								</div>
							</div>
						</div>
					</div>
				}
			}
		</div>
		<div class="row justify-content-center mt-5">
			<div class="col-lg-6 text-center">
				<nav class="navigation pagination d-inline-block">
					<div class="nav-links">
						<a class="prev page-numbers" href="#">Prev</a>
						<span aria-current="page" class="page-numbers current">1</span>
						<a class="page-numbers" href="#">2</a>
						<a class="next page-numbers" href="#">Next</a>
					</div>
				</nav>
			</div>
		</div>
	</div>
</section>


