@using IcBlog.Helper
@model BlogIndexViewModel

@{
	ViewData["Title"] = "IC Blog";
}
<section class="page-title bg-1">
	<div class="container">
		<div class="row">
			<div class="col-md-12">
				<div class="block text-center">
					<span class="text-white">Our blog</span>
					<h1 class="text-capitalize mb-4 text-lg">IC blog</h1>
					<ul class="list-inline">
						<li class="list-inline-item"><a href="/" class="text-white">Home</a></li>
						<li class="list-inline-item"><span class="text-white">/</span></li>
						<li class="list-inline-item"><a href="/blog.html" class="text-white-50"> Blog</a></li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>
<section class="section blog-wrap bg-gray">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-9">
				<div class="row">
					@foreach (var item in Model.Blogs)
					{

						<div class="col-lg-4 col-md-3 mb-5">
							<div class="blog-item">
								<div class="blog-item-image">
									<a asp-controller="Blog" asp-action="Details" asp-route-id="@item.BlogID">
																					
									<img src="~/UserFiles/@($"{AppUtilities.LocDau(item.Author.FirstName)}{AppUtilities.LocDau(item.Author.LastName)}")/@item.BlogID/BlogImage.jpg" alt="" class="img-fluid rounded">
									</a>
									<!-- Category label -->
									<div class="blog-item-category">
										<a asp-controller="Blog" asp-action="Index" asp-route-category="@item.CategoryID">@item.Category.Name</a>
									</div>
								</div>
								<div class="blog-item-content bg-white p-5">
									<h3 style="line-height: 24px; font-size:1rem;" class="mt-3 mb-3"><a asp-controller="Blog" asp-action="Details" asp-route-id="@item.BlogID">@item.Title</a></h3>
									<div class="blog-item-meta py-1 ">
										<span class="text-muted text-capitalize mr-3"><i class="ti-pencil-alt mr-2"></i>@($"{item.Author.FirstName} {item.Author.LastName}")</span>

										<span class="text-black text-capitalize mr-3"><i class="ti-time mr-1"></i>@item.DateTime?.ToString("dd/MM/yyyy")</span>
									</div>
								</div>
							</div>
						</div>

					}
				</div>
			</div>
			@await Component.InvokeAsync("SideBar")
		</div>

	
	</div>
	<div class="row mt-5">
		<div class="col-lg-8">
			<nav class="navigation pagination py-2 d-inline-block text-center">
				<div class="nav-links d-flex justify-content-center">
					<a class="prev page-numbers" href="#">Prev</a>
					<span aria-current="page" class="page-numbers current">1</span>
					<a class="page-numbers" href="#">2</a>
					<a class="next page-numbers" href="#">Next</a>
				</div>
			</nav>
		</div>
	</div>
</section>

