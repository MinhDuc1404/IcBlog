@using IcBlog.Helper;
@model HomeViewModel

@{
    ViewData["Title"] = "IC Home";
}
<div id="carouselExampleControls" class="carousel slide" data-ride="carousel" data-interval="5000">
	<div class="carousel-inner">
		@foreach (var item in Model.Blogs)
		{
			var isActive = item == Model.Blogs.First() ? "active" : "";
			<div class="carousel-item @isActive">
				<div class="overlay-container">
					<img class="d-block w-100" src="~/UserFiles/@($"{AppUtilities.LocDau(item.Author.FirstName)}{AppUtilities.LocDau(item.Author.LastName)}")/@item.BlogID/BlogImage.jpg" height="450px" alt="Blog Image">
					<div class="overlay"></div>
					<div class="carousel-caption d-none d-md-block">
						<!-- Phần thông tin danh mục (lên đầu) -->
						<div class="carousel-item-category">
							<a asp-controller="Blog" asp-action="Index" asp-route-category="@item.CategoryID">
								@item.Category.Name
							</a>
						</div>
						<a asp-controller="Blog" asp-action="Details" asp-route-id="@item.BlogID"><h5>@item.Title</h5> </a>
						<p>@Html.Raw(AppUtilities.ConvertHtmlToPlainText(item.Content.Substring(0,200)) + "...")</p>
					</div>
				</div>
			</div>
		}
	</div>
	<a class="carousel-control-prev" href="#carouselExampleControls" style="width:2%" role="button" data-slide="prev">
		<span class="carousel-control-prev-icon" aria-hidden="true"></span>
		<span class="sr-only">Previous</span>
	</a>
	<a class="carousel-control-next" href="#carouselExampleControls" style="width:2%" role="button" data-slide="next">
		<span class="carousel-control-next-icon" aria-hidden="true"></span>
		<span class="sr-only">Next</span>
	</a>
</div>
<section class="section blog-wrap bg-gray">
	<div class="container-fluid">
		<div class="row">
			@if(Model.Blogs != null && Model.Blogs.Any())
			{
				foreach (var item in Model.Blogs)
				{
				<div class="col-lg-3 col-md-6 mb-5">
					<div class="blog-item">
							<div class="blog-item-image">
								<a asp-controller="Blog" asp-action="Details" asp-route-id="@item.BlogID">
								<img src="~/UserFiles/@($"{AppUtilities.LocDau(item.Author.FirstName)}{AppUtilities.LocDau(item.Author.LastName)}")/@item.BlogID/BlogImage.jpg" alt="" class="img-fluid rounded">
								</a>
								<!-- Category label -->
								<div class="blog-item-category">
									<a asp-controller="Blog" asp-action="Index" asp-route-category="@item.CategoryID">@item.Category.Name</a>
								</div>
							</div>
					<div class="blog-item-content bg-white p-5">
					<h3 style="line-height: 28px; font-size:1.3rem;" class="mt-3 mb-3"><a asp-controller="Blog" asp-action="Details" asp-route-id="@item.BlogID">@item.Title</a></h3>
						<div class="blog-item-meta py-1">
							<span class="text-muted text-capitalize mr-3"><i class="ti-pencil-alt mr-2"></i>@($"{item.Author.FirstName} {item.Author.LastName}")</span>

									<span class="text-black text-capitalize mr-3"><i class="ti-time mr-1"></i>@item.DateTime?.ToString("dd/MM/yyyy")</span>
						</div>
					</div>
				</div>
			</div>
				}
			}
		</div>
		<div class="row justify-content-center mt-5">
			<div class="col-lg-6 text-center">
				<a asp-controller="Blog" asp-action="Index" class="btn btn-small btn-main btn-round-full">Đọc Thêm</a>
			</div>
		</div>
	</div>
</section>