@{
    Layout = "/Views/Shared/_UserLayout.cshtml";
}
@using IcBlog.Helper
@model UserAccountViewModel

@{
    ViewData["Title"] = "User Information";
    int i = 1;
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3 font-weight-bold">Full Name:</div>
                <div class="col-md-9">@Model.UserAccount.FirstName @Model.UserAccount.LastName</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 font-weight-bold">Email:</div>
                <div class="col-md-9">@Model.UserAccount.Email</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 font-weight-bold">Phone Number:</div>
                <div class="col-md-9">@Model.UserAccount.PhoneNumber</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 font-weight-bold">Address:</div>
                <div class="col-md-9">@Model.UserAccount.Address</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 font-weight-bold">Created Date:</div>
                <div class="col-md-9">@Model.UserAccount.CreatedDate.ToString("f")</div>
            </div>
        </div>
    </div>
</div>
<br />
<div class="container">
    <div class="card-header bg-primary text-white">
        <h2>Danh sách Blog</h2>
    </div>
    <br />
    <div class="row">
        @foreach (var item in Model.Blogs)
        {
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-0 shadow">
                    <img src="~/UserFiles/@($"{AppUtilities.LocDau(item.Author.FirstName)}{AppUtilities.LocDau(item.Author.LastName)}")/@item.BlogID/BlogImage.jpg" class="card-img-top">
                    <div class="card-body">
                        <div class="row" style="margin: 0px auto 10px 0px;">
                            <div><h5 class="card-title mb-0">@item.Title</h5></div>
                        </div>
                        <div class="row ml-0">
                            <div><i class="fas fa-calendar-alt" style="color: gray"></i></div>
                            <p class="text-muted ml-3 mb-0">Last updated on: @item.DateTime?.ToString()</p>
                        </div>
                        <div class="row ml-0" style="bottom: 0;">
                            <div><i class="fas fa-comment" style="color: gray"></i></div>
                            <p class="text-muted ml-3 mb-0">@item.Comments?.Count() Bình luận</p>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="row">
                            <div class="col">
                                <a asp-controller="Blog" asp-action="Details" asp-route-id="@item.BlogID" class="btn btn-primary">
                                    <i class="fa fa-arrow-circle-right"></i> View
                                </a>
                            </div>
                            <div class="col">
                                <a asp-controller="Blog" asp-action="Update" asp-route-id="@item.BlogID" class="btn btn-secondary float-right">
                                    <i class=" fa fa-edit"></i> Edit
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        
    </div> 
