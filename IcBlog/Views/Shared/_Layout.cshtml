<!doctype html>
<html lang="en">
<head>
	<!-- Required meta tags -->
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<meta name="description" content="megakit,business,company,agency,multipurpose,modern,bootstrap4">

	<meta name="author" content="themefisher.com">

	<title>@ViewData["Title"]</title>

	<!-- bootstrap.min css -->
	<link rel="stylesheet" href="~/testtemplate/plugins/bootstrap/css/bootstrap.min.css">
	<!-- Icon Font Css -->
	<link rel="stylesheet" href="~/testtemplate/plugins/themify/css/themify-icons.css">
	<link rel="stylesheet" href="~/testtemplate/plugins/fontawesome/css/all.css">
	<link rel="stylesheet" href="~/testtemplate/plugins/magnific-popup/dist/magnific-popup.css">
	<!-- Owl Carousel CSS -->
	<link rel="stylesheet" href="~/testtemplate/plugins/slick-carousel/slick/slick.css">
	<link rel="stylesheet" href="~/testtemplate/plugins/slick-carousel/slick/slick-theme.css">

	<!-- Main Stylesheet -->
	<link rel="stylesheet" href="~/testtemplate/css/style.css">

</head>

<body>

	<!-- Header Start -->

	<header class="navigation">

		<nav class="navbar navbar-expand-lg  py-4" id="navbar">
			<div class="container">
				<a class="navbar-brand" href="/">
					IC<span>Blog.</span>
				</a>

				<button class="navbar-toggler collapsed" type="button" data-toggle="collapse" data-target="#navbarsExample09" aria-controls="navbarsExample09" aria-expanded="false" aria-label="Toggle navigation">
					<span class="fa fa-bars"></span>
				</button>

				<div class="collapse navbar-collapse text-center" id="navbarsExample09">
					<ul class="navbar-nav ml-auto">
						<li class="nav-item active">
							<a class="nav-link" href="/">Trang chủ <span class="sr-only">(current)</span></a>
						</li>
						<li class="nav-item">
							<a class="nav-link" asp-controller="Blog" asp-action="Index">Tác Giả <span class="sr-only">(current)</span></a>
						</li>
						<li class="nav-item">
							<a class="nav-link" asp-controller="Blog" asp-action="Index">Bài viết <span class="sr-only">(current)</span></a>
						</li>
						

						@await Html.PartialAsync("_LoginPartial")
					</ul>
				</div>
			</div>
		</nav>
	</header>

	<!-- Header Close -->

	<div class="main-wrapper ">
	

		@RenderBody()

		<!-- footer Start -->
	@await Component.InvokeAsync("Footer")

	</div>

	<!--
	Essential Scripts
	=====================================-->
	<!-- Main jQuery -->
	<script src="~/testtemplate/plugins/jquery/jquery.js"></script>
	<script src="js/contact.js"></script>
	<!-- Bootstrap 4.3.1 -->
	<script src="~/testtemplate/plugins/bootstrap/js/popper.js"></script>
	<script src="~/testtemplate/plugins/bootstrap/js/bootstrap.min.js"></script>
	<!--  Magnific Popup-->
	<script src="~/testtemplate/plugins/magnific-popup/dist/jquery.magnific-popup.min.js"></script>
	<!-- Slick Slider -->
	<script src="~/testtemplate/plugins/slick-carousel/slick/slick.min.js"></script>
	<!-- Counterup -->
	<script src="~/testtemplate/plugins/counterup/jquery.waypoints.min.js"></script>
	<script src="~/testtemplate/plugins/counterup/jquery.counterup.min.js"></script>

	<!-- Google Map -->
	<script src="~/testtemplate/plugins/google-map/map.js"></script>
	<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAkeLMlsiwzp6b3Gnaxd86lvakimwGA6UA&callback=initMap"></script>

	<script src="~/testtemplate/js/script.js"></script>
	@await RenderSectionAsync("Scripts", false)

</body>
</html>