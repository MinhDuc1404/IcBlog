@using Microsoft.AspNetCore.Identity
@using IcBlog.Infrastructure.Models
@using IcBlog.Helper
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);

    if (user != null)
    {

        <li class="nav-item d-flex align-items-center">
            <a asp-controller="UserAccount" asp-action="Index">
            <img src="~/UserFiles/@(AppUtilities.LocDau((await UserManager.GetUserAsync(User)).Id))/ProfilePicture.jpg" width="40px" height="40px" alt="" style="border-radius: 50%; object-fit: cover;">
            <a class="nav-link"> @($"{user.FirstName} {user.LastName}!")</a>

        <li class="nav-item">
            <a class="nav-link" asp-controller="UserAccount" asp-action="Index">
                <img style=" width:30px;height:30px;position:relative;bottom:5px;border-radius:50%;" src="~/UserFiles/@user.Id/ProfilePicture.jpg" />

            </a>
        </li>
    }
    else
    {
     
        <li class="nav-item">

            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login" style="color: w">Login</a>

            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>

        </li>
    }
}
else
{
 
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
    </li>
}